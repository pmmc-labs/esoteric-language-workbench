fn isEven(n) {
  if n == 0 { return true }
  if n < 0 { return isEven(-n) }
  return isOdd(n - 1)
}
fn isOdd(n) {
  if n == 0 { return false }
  if n < 0 { return isOdd(-n) }
  return isEven(n - 1)
}
