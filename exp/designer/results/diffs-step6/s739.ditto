fn rep(s, n) {
  let r = ""
  for i in 0..n { r += s }
  return r
}
fn fact(n) {
  if n <= 1 {
    return 1
  }
  return n * fact(n - 1)
}
fn fib(n) {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}
fn sumlist(xs) {
  let t = 0
  for x in xs { t += x }
  return t
}
