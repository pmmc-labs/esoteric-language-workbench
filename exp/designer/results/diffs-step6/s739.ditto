fn swap(a, b) {
  let t = a
  a = b
  b = t
  return [a, b]
}
fn isEven(n) {
  if n == 0 { return true }
  if n < 0 { return isEven(-n) }
  return isOdd(n - 1)
}
fn isOdd(n) {
  if n == 0 { return false }
  if n < 0 { return isOdd(-n) }
  return isEven(n - 1)
}
fn rev(s) {
  let r = ""
  for c in s { r = c + r }
  return r
}
fn gcd(a, b) {
  while b != 0 {
    let t = b
    b = a % b
    a = t
  }
  return a
}
fn mutm(m) {
  m.a = 100
  m["zz"] = 1
  return m
}
