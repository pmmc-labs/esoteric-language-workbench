fn rep(s, n) {
  let r = ""
  for i in 0..n { r += s }
  return r
}
fn collatz(n) {
  let steps = 0
  while n != 1 {
    if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
    steps += 1
  }
  return steps
}
fn fact(n) {
  if n <= 1 {
    return 1
  }
  return n * fact(n - 1)
}
fn fib(n) {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}
