fn isEven(n) {
  if n == 0 { return true }
  if n < 0 { return isEven(-n) }
  return isOdd(n - 1)
}
fn isOdd(n) {
  if n == 0 { return false }
  if n < 0 { return isOdd(-n) }
  return isEven(n - 1)
}
fn fib(n) {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}
fn early(n) {
  for i in 0..10 {
    if i == n { return i * 2 }
  }
  return -1
}
