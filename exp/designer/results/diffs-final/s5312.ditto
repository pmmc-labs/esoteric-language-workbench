fn rev(s) {
  let r = ""
  for c in s { r = c + r }
  return r
}
fn collatz(n) {
  let steps = 0
  while n != 1 {
    if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
    steps += 1
  }
  return steps
}
fn isEven(n) {
  if n == 0 { return true }
  if n < 0 { return isEven(-n) }
  return isOdd(n - 1)
}
fn isOdd(n) {
  if n == 0 { return false }
  if n < 0 { return isOdd(-n) }
  return isEven(n - 1)
}
