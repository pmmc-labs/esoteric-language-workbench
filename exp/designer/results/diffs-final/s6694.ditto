fn classify(n) {
  if n < 0 { return "neg" } else if n == 0 { return "zero" }
  return "pos"
}
fn gcd(a, b) {
  while b != 0 {
    let t = b
    b = a % b
    a = t
  }
  return a
}
fn fib(n) {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}
