fn classify(n) {
  if n < 0 { return "neg" } else if n == 0 { return "zero" }
  return "pos"
}
fn rsum(xs, i) {
  if i >= len(xs) { return 0 }
  return xs[i] + rsum(xs, i + 1)
}
