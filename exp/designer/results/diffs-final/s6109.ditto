fn count(xs, x) {
  let c = 0
  for y in xs { if y == x { c += 1 } }
  return c
}
fn fact(n) {
  if n <= 1 {
    return 1
  }
  return n * fact(n - 1)
}
fn fnl(n) {
  if n > 0 { return }
  print("fnl", n)
}
