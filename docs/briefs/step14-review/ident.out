### own-my-only
my @s; for my $i (1..2) { push @s, sub { my $y = 1; $y } }
say $s[0] == $s[1] ? "same" : "diff";
--- perl:
same
[exit 0]

### file-var
my $g = 1; my @s; for my $i (1..2) { push @s, sub { $g } }
say $s[0] == $s[1] ? "same" : "diff";
--- perl:
diff
[exit 0]

### file-array
my @g = (1); my @s; for my $i (1..2) { push @s, sub { $g[0] } }
say $s[0] == $s[1] ? "same" : "diff";
--- perl:
diff
[exit 0]

### file-hash
my %g = (a => 1); my @s; for my $i (1..2) { push @s, sub { $g{a} } }
say $s[0] == $s[1] ? "same" : "diff";
