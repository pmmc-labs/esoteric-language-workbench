### store-in-closure
my @a = (1, 2); my @s;
for my $x (@a) { push @s, sub { $x = 5 } }
$s[0]->(); say "@a";
--- perl:
5 2
[exit 0]

### inc-in-closure
my @a = (1, 2); my @s;
for my $x (@a) { push @s, sub { $x++ } }
$s[0]->(); $s[0]->(); say "@a";
--- perl:
3 2
[exit 0]

### append-in-closure
my @a = ("a", "b"); my @s;
for my $x (@a) { push @s, sub { $x .= "!" } }
$s[1]->(); say "@a";
--- perl:
a b!
[exit 0]

### store-in-closure-during-loop
my @a = (1, 2);
for my $x (@a) { my $f = sub { $x = 7 }; $f->(); }
say "@a";
--- perl:
7 7
[exit 0]

### viv-in-closure
my @a = (undef, undef); my @s;
for my $x (@a) { push @s, sub { $x->[0] = 1 } }
$s[0]->(); say join ",", map { ref($_) || "plain" } @a;
--- perl:
ARRAY,plain
[exit 0]

### viv-push-in-closure
my @a = (undef); my @s;
for my $x (@a) { push @s, sub { push $x->@*, 1 } }
$s[0]->(); say ref($a[0]) || "plain";
--- perl:
ARRAY
[exit 0]

### viv-in-closure-hash-values
my %h = (k => undef); my @s;
for my $v (values %h) { push @s, sub { $v->{z} = 1 } }
$s[0]->(); say ref($h{k}) || "plain";
--- perl:
HASH
[exit 0]

### two-closures-share-loopvar
my @a = (1); my ($get, $set);
for my $x (@a) { $get = sub { $x }; $set = sub { $x = 4 } }
$set->(); say $get->(), " ", $a[0];
--- perl:
4 4
[exit 0]

### scalar-ternary
my ($p, $q, $c) = (1, 2, 1); my @s;
for my $x ($c ? $p : $q) { push @s, sub { $x } }
$p = 9; say $s[0]->();
--- perl:
9
[exit 0]

