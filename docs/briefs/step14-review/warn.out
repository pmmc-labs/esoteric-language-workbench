### outer-same-name-init
my $f = sub { "outer" }; { my $f = sub { $f->() . "+inner" }; say $f->(); }
--- perl:
outer+inner
[exit 0]

### default-captures-earlier-param
my $f = sub ($x, $g = sub { $x * 2 }) { $g->() }; say $f->(4);
--- perl:
8
[exit 0]

