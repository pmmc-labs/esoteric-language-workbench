### current-sub-outside
say defined __SUB__ ? "def" : "undef";
--- perl:
undef
[exit 0]

### current-sub-named
sub nm5() { return __SUB__ } say nm5() == \&nm5 ? "same" : "diff";
--- perl:
same
[exit 0]

### current-sub-in-map
my $f = sub { my @l = map { __SUB__ } 1; return $l[0] }; say $f->() == $f ? "same" : "diff";
--- perl:
same
[exit 0]

### current-sub-in-sort
my $f = sub { my $s; my @l = sort { $s = __SUB__; $a <=> $b } 2, 1; return $s }; say $f->() == $f ? "same" : "diff";
--- perl:
same
[exit 0]

