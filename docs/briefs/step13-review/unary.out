my $r = [[1], 5]; say ref($r->@*);
--- perl:

[exit 0]

### uc-postfix-array
my $r = ["a", "b"]; say uc($r->@*);
--- perl:
2
[exit 0]

### chr-postfix-array
my $r = [65, 66]; say chr($r->@*);
