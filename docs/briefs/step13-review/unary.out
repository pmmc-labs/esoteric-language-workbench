### ord-lastidx
my $r = [65, 66]; say ord($r->$#*);
--- perl:
49
[exit 0]

### ref-slice
my $r = [[1], 5]; say ref($r->@[0, 1]) || "empty";
--- perl:
empty
[exit 0]

### scalar-slice-postfix
my $r = [7, 8]; my $x = $r->@[0, 1]; say $x;
--- perl:
8
[exit 0]

### keys-elem-hash
my $r = {a => {b => 1}}; say scalar(keys $r->{a}->%*);
--- perl:
1
[exit 0]

### ref-keys
my $r = {a => 1}; say ref(keys $r->%*) || "empty";
--- perl:
empty
[exit 0]

