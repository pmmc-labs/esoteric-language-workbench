### defined-postfix-array
my $r = [1]; say defined $r->@* ? "y" : "n";
--- perl:
stderr: Can't use 'defined(@array)' (Maybe you should just omit the defined()?) at - line 2.
[exit 255]

### defined-braces-array
my $r = [1]; say defined(@{ $r }) ? "y" : "n";
--- perl:
stderr: Can't use 'defined(@array)' (Maybe you should just omit the defined()?) at - line 2.
[exit 255]

### defined-postfix-hash
my $r = {a => 1}; say defined $r->%* ? "y" : "n";
--- perl:
stderr: Can't use 'defined(%hash)' (Maybe you should just omit the defined()?) at - line 2.
[exit 255]

### length-postfix-array
my $r = [1, 2, 3]; say length($r->@*);
--- perl:
1
stderr: length() used on @array (did you mean "scalar(@array)"?) at - line 2.
[exit 0]

### length-braces-hash
my $r = {a => 1}; say length(%{ $r });
--- perl:
1
stderr: length() used on %hash (did you mean "scalar(keys %hash)"?) at - line 2.
[exit 0]

### ref-postfix-array
my $r = [[1]]; say ref($r->@*);
--- perl:

[exit 0]

