### p-ref-brace
my $t = ref {a => 1}; say $t;
--- perl:
HASH
[exit 0]

### p-ref-brace-var
my $x = "k"; my $t = ref { $x => 1 }; say $t;
--- perl:
HASH
[exit 0]

### p-defined-brace
say defined {a => 1} ? "y" : "n";
--- perl:
y
[exit 0]

### p-scalar-brace
my $n = scalar({a => 1}); say ref $n;
--- perl:
HASH
[exit 0]

### p-not-brace
say !{a => 1} ? "y" : "n";
--- perl:
n
[exit 0]

### p-reverse-brace
my @l = reverse { a => 1 }; say scalar(@l), " ", ref $l[0];
--- perl:
1 HASH
[exit 0]

### p-reverse-brace-var
