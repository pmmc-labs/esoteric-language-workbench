### for-call-returning-elems
my $r = [1, 2, 3];
sub all() { return $r->@*; }
for my $x (all()) { $r = [7, 8, 9]; say $x; }
--- perl:
1
2
3
[exit 0]

### for-scalar-deref-replace
my $x = 1; my $y = 2; my $r = \$x;
for my $v ($r->$*, 0) { $r = \$y; say $v; }
--- perl:
1
0
[exit 0]

### for-scalar-deref-freed
sub mk() { my $t = 5; return \$t; }
my $r = mk();
for my $v ($r->$*, 0) { $r = mk(); say $v; }
--- perl:
5
0
[exit 0]

