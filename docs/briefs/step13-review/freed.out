### for-single-replace
my $r = [1, 2, 3];
for my $x ($r->@*) { $r = [7, 8, 9]; say $x; }
--- perl:
1
2
3
[exit 0]

### for-list-replace
my $r = [1, 2, 3];
for my $x ($r->@*, 0) { $r = [7, 8, 9]; say $x; }
--- perl:
1
stderr: Use of freed value in iteration at - line 3.
[exit 255]

### for-braces-list-replace
my $r = [1, 2, 3];
for my $x (@{ $r }, 0) { $r = [7, 8, 9]; say $x; }
--- perl:
1
stderr: Use of freed value in iteration at - line 3.
[exit 255]

### map-replace
my $r = [1, 2, 3];
my @m = map { $r = [7, 8, 9]; $_ * 10 } $r->@*;
say "@m";
--- perl:
10 80 90
stderr: Attempt to free unreferenced scalar: SV 0x55e066481478 at - line 4.
[exit 0]

### grep-replace
my $r = [1, 2, 3];
my @m = grep { $r = [7, 8, 9]; $_ > 1 } $r->@*;
say "@m";
--- perl:

stderr: Use of uninitialized value $_ in numeric gt (>) at - line 3.
stderr: Attempt to free unreferenced scalar: SV 0x55f87f4c2508 at - line 3.
stderr: Use of uninitialized value $m[0] in join or string at - line 4.
stderr: Attempt to free unreferenced scalar: SV 0x55f87f4c2478 at - line 4.
stderr: Attempt to free unreferenced scalar: SV 0x55f87f4c2478.
[exit 0]

### sort-replace
my $r = [3, 1, 2];
my @m = sort { $r = [7, 8, 9]; $a <=> $b } $r->@*;
say "@m";
--- perl:
stderr: Use of uninitialized value $b in numeric comparison (<=>) at - line 3.
stderr: Attempt to free unreferenced scalar: SV 0x55e698de0478 at - line 3.
stderr: Bizarre copy of ARRAY in list assignment at - line 3.
[exit 255]

### for-delete-hash
my %h = (l => [1, 2, 3]);
for my $x ($h{l}->@*) { delete $h{l}; say $x; }
--- perl:
1
2
3
[exit 0]

