[exit 255]

### map-values-ref-replace
my $r = {a => 1, b => 2};
my @m = map { $r = {}; $_ * 10 } sort { $a <=> $b } values $r->%*;
say "@m";
--- perl:
10 0
stderr: Use of uninitialized value $_ in multiplication (*) at - line 3.
stderr: Attempt to free unreferenced scalar: SV 0x55a3d91fe478 at - line 3.
[exit 0]

### map-values-ref-replace-nosort
my $r = {a => 1};
my @m = map { $r = {z => 5}; $_ * 10 } values $r->%*;
say "@m";
--- perl:
10
[exit 0]

### for-values-ref-replace
my $r = {a => 1, b => 1};
for my $v (values $r->%*) { $r = {}; my @junk = map { [$_] } 1 .. 50; say $v; }
--- perl:
1
stderr: Use of freed value in iteration at - line 3.
[exit 255]

### map-replace-junk
my $r = [1, 2, 3];
my @m = map { $r = [7, 8, 9]; my @junk = map { "j$_" } 1 .. 20; $_ } $r->@*;
say "@m";
--- perl:
1 9 8
stderr: Attempt to free unreferenced scalar: SV 0x55e62adca3e8 at - line 4.
[exit 0]

### grep-array-of-arrays-replace
my $r = [[1], [2], [3]];
my @m = grep { $r = []; my @j = map { [$_ * 100] } 1 .. 20; $_->[0] > 1 } $r->@*;
say scalar(@m);
--- perl:
stderr: free(): double free detected in tcache 2
[exit -6]

