### while-my-ref
my @a = (1, 2, 3); my @r;
while (my $x = shift @a) { push @r, \$x; }
say join ",", map { defined $_->$* ? $_->$* : "u" } @r;
--- perl:
1,2,3
[exit 0]

### while-my-ref-last
my $n = 0; my @r;
while (my $x = ++$n) { push @r, \$x; last if $n == 3; }
say join ",", map { $_->$* } @r;
--- perl:
1,2,3
[exit 0]

### until-my-ref
my $n = 0; my @r;
until ((my $x = ++$n) > 3) { push @r, \$x; }
say join ",", map { $_->$* } @r;
--- perl:
1,2,3
[exit 0]

### for-c-my-ref
my @r;
for (my $i = 0; $i < 3; $i++) { push @r, \$i; }
say join ",", map { $_->$* } @r;
--- perl:
3,3,3
[exit 0]

### if-my-ref-loop
my @r;
for my $k (1 .. 3) { if ((my $x = $k) > 0) { push @r, \$x; } }
say join ",", map { $_->$* } @r;
--- perl:
1,2,3
[exit 0]

### block-my-ref-loop
my @r;
for my $k (1 .. 3) { my $x = $k; push @r, \$x; }
say join ",", map { $_->$* } @r;
--- perl:
1,2,3
[exit 0]

### block-my-noinit-ref-loop
my @r;
for my $k (1 .. 3) { my $x; $x = $k if $k == 1; push @r, \$x; }
say join ",", map { defined $_->$* ? $_->$* : "u" } @r;
--- perl:
1,u,u
[exit 0]

### while-my-noinit
my $n = 0; my @r;
while ($n < 3) { $n++; my $x; $x = $n if $n == 1; push @r, \$x; }
say join ",", map { defined $_->$* ? $_->$* : "u" } @r;
--- perl:
1,u,u
[exit 0]

### file-var-before-my
sub f() { return \$x; }
my $x = 5;
say f()->$*;
--- perl:
stderr: Global symbol "$x" requires explicit package name (did you forget to declare "my $x"?) at - line 2.
stderr: Execution of - aborted due to compilation errors.
[exit 255]

### ref-ref
my $x = 5; my $r = \$x; my $s = \$r;
say ref $s, " ", ref $r, " ", $s->$*->$*;
--- perl:
REF SCALAR 5
[exit 0]

### ref-of-ref-later
my $x = 5; my $r = \$x; say ref $r; $x = [1]; say ref $r;
--- perl:
SCALAR
REF
[exit 0]

### scalar-ref-eq
my $x = 1; say \$x == \$x ? "same" : "diff";
--- perl:
same
[exit 0]

### param-ref
sub f($p) { my $r = \$p; $r->$* = 9; return $p; }
my $v = 1; say f($v), " ", $v;
--- perl:
9 1
[exit 0]

### deref-assign-ops
my $x = 1; my $r = \$x;
$r->$* .= "a"; ${ $r } .= "b"; $r->$*++; say $x;
--- perl:
2
stderr: Argument "1ab" isn't numeric in preincrement (++) at - line 3.
[exit 0]

### deref-plusplus-str
my $x = "a9"; my $r = \$x; $r->$*++; say $x;
--- perl:
b0
[exit 0]

### store-undef-scalar
my $s; $s->$* = 5; say ref $s, " ", $s->$*;
--- perl:
SCALAR 5
[exit 0]

### store-undef-scalar-braces
my $s; ${ $s } = 5; say ref $s;
--- perl:
SCALAR
[exit 0]

### ref-bool-x
my $r = [1]; say "a" x !!$r;
--- perl:
a
[exit 0]

### ref-in-ternary-numeric
my $r = [1]; my $s = $r; say(($r == $s) + 0);
--- perl:
1
[exit 0]

