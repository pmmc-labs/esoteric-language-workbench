### store-self-viv
my $r; $r->[0] = $r;
say defined $r->[0] ? ref($r->[0]) . ($r->[0] == $r ? " self" : " other") : "undef";
--- perl:
ARRAY self
[exit 0]

### store-self-viv-hash
my %h = (a => undef); $h{a}{b} = $h{a};
say defined $h{a}{b} ? ref($h{a}{b}) : "undef";
--- perl:
HASH
[exit 0]

### store-self-viv-missing
my %h; $h{a}{b} = $h{a};
say defined $h{a}{b} ? ref($h{a}{b}) : "undef";
--- perl:
undef
[exit 0]

### store-self-viv-dor
my $r; $r->[0] = $r // 7;
say defined $r->[0] ? (ref($r->[0]) || $r->[0]) : "undef";
--- perl:
7
[exit 0]

### store-self-viv-and
my $r; $r->{a} = $r && 1;
say defined $r->{a} ? (ref($r->{a}) || $r->{a}) : "undef";
--- perl:
HASH
[exit 0]

### store-self-viv-ternary
my $r; my $c = 1; $r->[0] = $c ? $r : 0;
say defined $r->[0] ? (ref($r->[0]) || $r->[0]) : "undef";
--- perl:
ARRAY
[exit 0]

### store-self-viv-paren
my $r; $r->[0] = ($r);
say defined $r->[0] ? (ref($r->[0]) || $r->[0]) : "undef";
--- perl:
ARRAY
[exit 0]

### store-other-viv
my $r; my $s; $r->[0] = $s; say defined $r->[0] ? "def" : "undef";
--- perl:
undef
[exit 0]

### aassign-self-viv
my $r; my $x; ($r->[0], $x) = ($r, 1);
say defined $r->[0] ? ref($r->[0]) : "undef";
--- perl:
ARRAY
[exit 0]

### opassign-self-viv
my $r; $r->[0] //= $r;
say defined $r->[0] ? ref($r->[0]) : "undef";
--- perl:
ARRAY
[exit 0]

### store-elem-viv-sub
my $r;
sub peek() { return defined $r ? "made" : "not yet"; }
$r->[0] = peek();
say $r->[0];
--- perl:
not yet
[exit 0]

### store-index-call-viv
my $r;
sub idx() { say defined $r ? "made" : "not yet"; return 0; }
$r->[idx()] = 1;
--- perl:
made
[exit 0]

