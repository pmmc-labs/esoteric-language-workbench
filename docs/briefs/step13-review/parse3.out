### deref-at-brace-hash-var
my $k = "a"; my @l = @{ { $k => 1 } }{a}; say "@l";
--- perl:
1
[exit 0]

### deref-dollar-brace-var
my $k = "a"; my $x = ${ { $k => \5 } }{a}; say $x;
--- perl:
SCALAR(0x56430190f508)
[exit 0]

### deref-at-bracket
my @l = @{ [1, 2] }; say "@l";
--- perl:
1 2
[exit 0]

### deref-lastidx-bracket
say $#{ [1, 2, 3] };
--- perl:
2
[exit 0]

### deref-at-plus-brace-var
my $k = "a"; my @k = keys %{ +{ $k => 1 } }; say "@k";
--- perl:
a
[exit 0]

