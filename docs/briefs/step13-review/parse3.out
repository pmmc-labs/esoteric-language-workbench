### deref-brace-hash-var
my $k = "a"; my @k = keys %{ { $k => 1 } }; say "@k";
--- perl:
a
[exit 0]

### deref-brace-hash-word
my @k = keys %{ { a => 1 } }; say "@k";
--- perl:
a
[exit 0]

### deref-brace-hash-lc
my $k = "A"; my @k = keys %{ { lc($k) => 1 } }; say "@k";
--- perl:
a
[exit 0]

### deref-brace-hash-empty
my $n = keys %{ {} }; say $n;
--- perl:
stderr: Unmatched right curly bracket at - line 2, at end of line
stderr: syntax error at - line 2, near "%{ {} }"
stderr: Execution of - aborted due to compilation errors.
