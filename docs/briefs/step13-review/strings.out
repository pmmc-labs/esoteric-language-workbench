### s-postfix-after-elem
my $r = [[1, 2]];
say "<$r->[0]->@*>";
--- perl:
<1 2>
[exit 0]

### s-postfix-after-elem-noarrow
my $r = [[1, 2]];
my @a = ([3, 4]);
say "<$a[0]->@*>";
--- perl:
<3 4>
[exit 0]

### s-lastidx-after-elem
my $r = [[1, 2]];
say "<$r->[0]->$#*>";
--- perl:
<1>
[exit 0]

### s-scalar-deref
my $x = 5; my $r = \$x;
say "<$r->$*>";
--- perl:
<5>
[exit 0]

### s-hash-deref
my $r = {a => 1};
say "<$r->%*>";
--- perl:
<HASH(0x562a07b7a7c8)->%*>
[exit 0]

