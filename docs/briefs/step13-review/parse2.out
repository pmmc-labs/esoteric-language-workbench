### say-paren-brace
say({a => 1}->{a});
--- perl:
1
[exit 0]

### say-paren-brace-var
my $k = "a"; say({ $k => 1 }->{a});
--- perl:
stderr: syntax error at - line 2, near "}->"
stderr: Execution of - aborted due to compilation errors.
[exit 255]

### say-paren-brace-plus
say(+{a => 1}->{a});
--- perl:
1
[exit 0]

### print-paren-brace
print({a => 5}->{a}, "\n");
--- perl:
5
[exit 0]

### say-paren-bracket
say([7]->[0]);
--- perl:
7
[exit 0]

### say-bracket
say [7]->[0];
--- perl:
7
[exit 0]

### say-paren-paren-brace
say(({a => 1})->{a});
--- perl:
1
[exit 0]

### say-brace-str-comma
say {"a", 1}->{a};
--- perl:
1
[exit 0]

### say-paren-brace-empty
say(scalar(%{{}}));
--- perl:
stderr: Unmatched right curly bracket at - line 2, at end of line
stderr: syntax error at - line 2, near "%{{}}"
stderr: Execution of - aborted due to compilation errors.
[exit 255]

### say-list-second-brace
say 1, {a => 2}->{a};
--- perl:
12
[exit 0]

### say-paren-brace-word-noarrow
my $h = {a => 1}; say({ a => 1 } == $h ? "same" : "diff");
--- perl:
diff
[exit 0]

