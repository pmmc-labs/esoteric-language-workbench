// Building a line of text: a receipt row, a name padded with dots and a
// right-aligned amount. concat is the only way to build a string, and
// toString turns the amount into one.
// Padding repeats, so it recurses. A function can't call itself by name,
// so each padder takes itself as its first argument, me, and passes it on.
// (Adding a method to String, as 04 does to Integer, is the other way.)
let padRight = function (me, s, width, filler) {
  s.size().lessThan(width).ifTrueFalse(
    function () { me(me, s.concat(filler), width, filler) },
    function () { s })
};
let padLeft = function (me, s, width, filler) {
  s.size().lessThan(width).ifTrueFalse(
    function () { me(me, filler.concat(s), width, filler) },
    function () { s })
};
let row = function (name, amount) {
  padRight(padRight, name, 8, ".").concat(padLeft(padLeft, amount.toString(), 5, " "))
};

// size counts code points, so the apple is one character and its row
// lines up with the others.
let apple = "🍎";
// There are no string escapes, so a row can't end in a newline: print
// writes each row on a line of its own, in quotes, as any string is shown.
// The last value, the two sizes, is printed after them.
let apples = 3;
let figs = 12;
print(row("apples", apples.times(4)));
print(row("figs", figs.times(25)));
print(row(apple, 7));
print(row("total", 319));
Array.new(row(apple, 7).size(), apple.size())
