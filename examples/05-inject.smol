// Iterating without a loop. SMOL has no loop form: an Array's each and
// inject call a block, a function, with every item in order, and indexOf
// searches and stops at the first match.
let xs = Array.new(4, 8, 15, 16, 23, 42);
let sum = xs.inject(0, function (acc, x) { acc.plus(x) });
let product = Array.new(1, 2, 3, 4).inject(1, function (acc, x) { acc.times(x) });

// each gives the array back, so its block is run for what it changes:
// here it pushes each double onto another array.
let doubles = Array.new();
xs.each(function (x) { doubles.push(x.times(2)) });

// A method built on inject, added to Array with define, so every array
// answers it. The fold starts from the first item.
Array.define("max", function (self) {
  self.inject(self.get(0), function (best, x) {
    best.lessThan(x).ifTrueFalse(function () { x }, function () { best })
  })
});

// indexOf answers -1 for a value that isn't there.
Array.new(sum, product, doubles, xs.max(), xs.indexOf(15), xs.indexOf(7))
