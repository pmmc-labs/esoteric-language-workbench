// A stack around an Array. The class holds the array in its attrs and
// answers push, pop and isEmpty by passing them on: Array's push adds to
// the end, and its pop removes the last item and gives it.
let Stack = create_class(Hash.new(
  "$name", "Stack",
  "$superclass", Object,
  "%methods", Hash.new(
    // Array's push gives the array, so this one gives the stack, to chain.
    "push", function (self, x) { self.attr("items").push(x); self },
    // Popping an empty stack gives nil, as Array's pop does.
    "pop", function (self) { self.attr("items").pop() },
    "isEmpty", function (self) { self.attr("items").size().equals(0) })));

let s = Stack.new("items", Array.new());
s.push(1).push(2).push(3);
let first = s.pop();
let second = s.pop();
s.push(4);
let third = s.pop();
let fourth = s.pop();
Array.new(first, second, third, fourth, s.isEmpty())
