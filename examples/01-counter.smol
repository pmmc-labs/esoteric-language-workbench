// A class with state. The count lives in the instance's attrs, the hash
// that new(key, value, ...) is given, and a method reads it with attr and
// writes it with setAttr: SMOL has no instance-variable syntax.
// The superclass is Object, so instances answer attr, setAttr, class(),
// isa and can; create_class alone would leave it nil.
let Counter = create_class(Hash.new(
  "$name", "Counter",
  "$superclass", Object,
  "%methods", Hash.new(
    "count", function (self) { self.attr("count") },
    // setAttr gives the instance back, so inc does too, and calls chain,
    // as Array's push does.
    "inc", function (self) { self.setAttr("count", self.count().plus(1)) },
    "incBy", function (self, n) { self.setAttr("count", self.count().plus(n)) })));

let a = Counter.new("count", 0);
let b = Counter.new("count", 10);
a.inc().inc().inc();
b.incBy(5).inc();
Array.new(a.count(), b.count(), a.class().name())
