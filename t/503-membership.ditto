let hits = 0
for i in 0..6 {
  if i in items[1] or [i] in items { hits += 1 }
}
print(hits)
let uniq = []
for x in [3, 1, 3, 2, 1, 2, 5, 3] {
  if x not in uniq { uniq += [x] }
}
print(uniq)
