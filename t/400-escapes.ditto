print("plain")
print(len("plain"))
print("")
print(len(""))
print("tab\there")
print(len("tab\there"))
print("line\nbreak")
print(len("line\nbreak"))
print("cr\rhere")
print(len("cr\rhere"))
print("back\\slash")
print(len("back\\slash"))
print("say \"hi\"")
print(len("say \"hi\""))
print("braces \{a} and \}b\{")
print(len("braces \{a} and \}b\{"))
print("\\n is not a newline")
print(len("\\n is not a newline"))
print("\"\\\"")
print(len("\"\\\""))
print("café 日本 €")
print(len("café 日本 €"))
print("// not a comment")
print(len("// not a comment"))
print("\}}\{\{")
print(len("\}}\{\{"))
print("a\tb\nc\rd\\e\"f\{g}h")
print(len("a\tb\nc\rd\\e\"f\{g}h"))
print("\n", "\t", "\\", "\"", "\{", "\}", "}")
print(len("\n\t\r\\\"\{\}"))
