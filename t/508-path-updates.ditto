g[1][1] = 1
g[2][2] = 1
g[3][3] = 1
print(g)
g[0][3] = 7
g[3][0] += 5
g[3][0] *= 5
g[3][0] -= 3
g[3][0] /= 4
g[3][0] %= 3
print(g)
for i in 0..4 {
  for j in 0..4 {
    g[i][j] += i * j
  }
}
print(g)
g[1] += [9]
g[len(g) - 1][len(g) - 1] = 42
g[1 + 1][g[0][3] - 6] += -1
print(g)
print(len(g[1]), len(g[0]), g[1][4])
let tmp = g[0]
g[0] = g[1]
g[1] = tmp
g[0][0] = 100
print(g, tmp)
