// Euclid's algorithm, by loop and by recursion.
fn gcd(a, b) {
  while b != 0 {
    let t = b
    b = a % b
    a = t
  }
  return a
}

fn gcd_rec(a, b) {
  if b == 0 { return a }
  return gcd_rec(b, a % b)
}

fn lcm(a, b) {
  return a / gcd(a, b) * b
}

print(12, 18, gcd(12, 18), gcd_rec(12, 18))
print(18, 12, gcd(18, 12), gcd_rec(18, 12))
print(0, 5, gcd(0, 5), gcd_rec(0, 5))
print(5, 0, gcd(5, 0), gcd_rec(5, 0))
print(1, 1, gcd(1, 1), gcd_rec(1, 1))
print(17, 5, gcd(17, 5), gcd_rec(17, 5))
print(100, 75, gcd(100, 75), gcd_rec(100, 75))
print(1071, 462, gcd(1071, 462), gcd_rec(1071, 462))
print(7, 7, gcd(7, 7), gcd_rec(7, 7))
print(1, 1000, gcd(1, 1000), gcd_rec(1, 1000))
print(1099511627776, 3656158440062976, gcd(1099511627776, 3656158440062976), gcd_rec(1099511627776, 3656158440062976))
print(123456789, 987654321, gcd(123456789, 987654321), gcd_rec(123456789, 987654321))
print(9223372036854775807, 3, gcd(9223372036854775807, 3), gcd_rec(9223372036854775807, 3))
print(9223372036854775807, 9223372036854775807, gcd(9223372036854775807, 9223372036854775807), gcd_rec(9223372036854775807, 9223372036854775807))
print(9223372036854775807, 9223372036854775806, gcd(9223372036854775807, 9223372036854775806), gcd_rec(9223372036854775807, 9223372036854775806))
print(46368, 28657, gcd(46368, 28657), gcd_rec(46368, 28657))
print(360, 84, gcd(360, 84), gcd_rec(360, 84))
print(1000000007, 998244353, gcd(1000000007, 998244353), gcd_rec(1000000007, 998244353))

print(lcm(12, 18))
print(lcm(4, 6))
print(lcm(21, 6))
print(lcm(1, 9))
print(lcm(8, 9))
print(lcm(1000, 1500))
print(lcm(123456, 7890))

print(gcd(2 * 3 * 7, 7 * 5 * 3), gcd_rec(gcd(48, 36), gcd(90, 60)))
