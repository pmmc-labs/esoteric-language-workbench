// The sketch's class_precedence_list assertions: a class, then its superclasses
// up to Object. Foo is object 100, its instance 101, Bar 102 and its instance 103.
let $Foo = Class.new("$name", "Foo", "$superclass", Object, "%methods", Hash.new(
    "foo", function (self) { "Foo->foo" },
    "bar", function (self) { "Foo->bar" }));
let $iFoo = $Foo.new();
let $Bar = Class.new("$name", "Bar", "$superclass", $Foo, "%methods", Hash.new(
    "bar", function (self) { "Bar->bar" },
    "baz", function (self) { "Bar->baz" }));
let $iBar = $Bar.new();
Array.new(Class.class_precedence_list(), Object.class_precedence_list(), $Foo.class_precedence_list(), $Bar.class_precedence_list())
