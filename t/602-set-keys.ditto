fn k(s) {
  print("key", s)
  return s
}
fn v(n) {
  print("value", n)
  return n
}
let o = {}
o[k("x")] = v(1)
o[k("y")] = v(2)
o[k("x")] = v(3)
print(o)
let counts = {}
for w in ["b", "a", "b", "c", "a", "b"] {
  if w in counts {
    counts[w] += 1
  } else {
    counts[w] = 1
  }
}
print(counts)
let t = {v: 1}
t["v"] = "text"
print(t)
t["v"] = nil
print(t)
t["v"] = true
print(t)
t["v"] = false
print(t)
t["v"] = [1, 2]
print(t)
t["v"] = {n: {}}
