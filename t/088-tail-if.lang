; An if in tail position, nested, calling in both branches (D33): the Collatz
; steps of 27 (111) by tail calls.
; Expected output from t/models/fn.py, a model of D31 to D34.
(def (collatz n steps)
    (if (== n 1)
        steps
        (if (== (% n 2) 0)
            (collatz (/ n 2) (+ steps 1))
            (collatz (+ (* 3 n) 1) (+ steps 1)))))
(collatz 27 0)
