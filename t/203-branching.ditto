for n in 1..=105 {
  if n % 15 == 0 {
    print(n, 1500)
  } else if n % 7 == 0 {
    print(n, 700)
  }
  else if n % 5 == 0 { print(n, 500) }
  else if n % 3 == 0 { print(n, 300) } else {
    print(n, 0)
  }
}
let hits = 0
for a in -4..=4 {
  for b in -4..=4 {
    if a < 0 {
      if b < 0 { hits += 1 } else { hits += 10 }
    } else if a == 0 {
      hits += 100
    } else {
      if b < 0 or b > 2 { hits += 1000 }
    }
  }
}
print(hits)
