fn touch_m(m) {
  m.touched = len(m)
  if "a" in m { m.a += 1 }
  return m
}
fn touch_n(n) {
  if "t" in n { n.t += [7] } else { n.t = [7] }
  for k in keys(n) {
    if k != "t" and len(n[k]) < 4 { n[k] += [1] }
  }
  return n
}
fn total(m) {
  let s = 0
  for k in m { s += m[k] }
  return s
}
