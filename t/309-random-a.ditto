fn f0(p0, p1, p2) {
  let v0 = --p1 - -(2 - 1)
  p2 = -1
  return -(-1 % -2)
}

fn f1() {
  let v0 = 1
  if f0(-1, v0, v0) > (-1 + v0) {
    return -(5 / -5)
  } else {
    v0 = f0(100, v0, -4) * 5
  }
  return f0(f0(v0, v0, v0) / 2, f0(v0, 1, 7) % 2, f0(5 - v0, f0(v0, v0, v0), v0 - 100))
}

fn f2(p0, p1, p2) {
  let v0 = 2
  for i1 in 0..3 {
    p1 = -3 - f0(100, p2, p2)
    if f0(i1, v0, i1) != (7 - p2) {
      return -1 % 7
    }
  }
  for i2 in 0..1 {
    p1 = f0(f1(), -1 % -5, p0 + p1)
  }
  return f0(f1(), v0, p2 % -2)
}

fn f3(p0) {
  let v0 = p0
  p0 = -(p0 + 100) - f1()
  v0 = v0
  v0 = f0((p0 % -5) / 7, f2(p0, 9 % 3, -5), (10 / 1) % -5)
  return 1 + v0
}

fn f4(p0) {
  if p0 > (p0 + p0) {
    return p0
  }
  if not ((1 - 1) >= -7) {
    return p0
  }
  return (f1() - (p0 + p0)) * f1()
}

fn f5(p0, p1) {
  let v0 = -((2 / 4) + -p1)
  let v1 = v0
  p1 = 9 * (-v0 - f0(9, v0, 3))
  if -p1 <= f2(p0, p0, 3) {
    return 5
  }
  for i1 in 0..6 {
    v1 = -100 - f2(p0, 10, v0)
  }
  return v1 + (f4(v1) + (p0 + -4))
}

print(f1())
print(f2(5, 8, 1))
print(f3(1))
print(f0(8, 2, 0))
print(f0(5, 12, 2))
print(f5(50, 3))
print(f1())
print(f4(8))
print(f4(2))
print(f5(1, 50))
print(f4(50))
print(f1())
print(f0(2, -7, 2))
print(f3(-1))
print(f1())
print(f2(f2(0 - -1, 7, f0(9, 9, 10)), 2 + (3 - 100), f0(-4, -0, -4 - 100)))
print(-f2(f1(), f5(2, 7), -1 + 0))
print(((1 % 3) % 1) - (--4 + (-4 / 7)))
