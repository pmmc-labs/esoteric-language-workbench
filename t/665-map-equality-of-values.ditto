print({a: 1} == {a: true}, {a: 0} == {a: false}, {a: nil} == {}, {a: nil} == {a: nil}, {a: [1]} == {a: [1]}, {a: [1]} == {a: [true]})
print({1: "a"} == {1: "a"}, {1: "a"} == {"1": "a"}, {a: {b: {c: 1}}} == {a: {b: {c: 1}}}, {a: {b: {c: 1}}} == {a: {b: {c: 2}}})
print([{}] == [{}], [{}] == [[]], {} == [], {} == 0, {} == "", {} == nil, {} == false)
let x = {p: 1, q: {r: [1, {s: 2}]}}
let y = {q: {r: [1, {s: 2}]}, p: 1}
print(x == y, x != y, y == x)
y.q.r[1].s = 3
print(x == y)
