let n = 5
if n > 10 {
  print(1)
}
else if n > 3 {
  print(2)
}

else {
  print(3)
}
if n < 0 { print(4) } else { print(5) }
if n == 5 {
  print(6)
} else if n == 6 {
  print(7)
} else if n == 7 {
  print(8)
}
if n != 5 {
  print(9)
} else {
  print(10)
}
if n == 0 {
  print(11)
} else if n == 1 {
  print(12)
}
print(13)
