fn f0(p0, p1) {
  if -p1 >= -p0 {
    return (1 - p0) - -p1
  }
  for i1 in 0..3 {
    p1 = p1
  }
  for i2 in 0..1 {
    p1 = -(i2 + 9)
    if -p1 > --1 {
      return p1 - -1
    }
  }
  return p1
}

fn f1(p0, p1) {
  let v0 = p0
  if (v0 != (v0 + p0)) and (-3 < (-4 / 1)) {
    return -p1
  } else {
    p1 = f0(p0, p1)
  }
  return p0
}

fn f2(p0, p1) {
  if not ((p1 * p0) != p1) {
    return p1
  } else {
    p1 = f1(p1, 7) - f0(5, 5)
  }
  return (-4 - --4) % 3
}

fn f3() {
  let v0 = -(9 - 10) + ((-1 + 5) + f2(7, 3))
  for i1 in 0..3 {
    v0 = (10 * 100) % -5
    if -9 != (i1 - v0) {
      return i1 + 100
    }
  }
  v0 = -f1(100 % -5, v0)
  for i2 in 0..0 {
    v0 = -1 * -i2
  }
  return f0(-4, f0(v0 % -5, v0 + v0))
}

fn f4(p0, p1, p2) {
  let v0 = f0(p2, (2 - p1) / 7)
  if ((10 % 7) < p0) and ((p0 - 5) <= v0) {
    return f1(f2(p0, v0), p2 % -2)
  }
  if 1 != f1(5, p0) {
    return (2 / 7) * f1(v0, v0)
  }
  for i1 in 0..0 {
    p1 = p2
  }
  return f3() - f1(f2(p0, -4), 3 / 3)
}

fn f5(p0) {
  let v0 = -(p0 / 4) * f1(9, p0 - -4)
  for i1 in 0..3 {
    v0 = f0(f2(3, v0), i1)
  }
  p0 = -100
  return ((v0 * 2) + (v0 / -5)) - ((v0 + p0) - v0)
}

print(f4(-1, 1, 0))
print(f5(8))
print(f0(1, -1))
print(f2(-7, 8))
print(f0(2, 5))
print(f3())
print(f5(50))
print(f4(12, 12, 2))
print(f2(-3, 0))
print(f1(-3, 2))
print(f4(1, 3, 5))
print(f3())
print(f5(-7))
print(f4(-1, 5, 12))
print(f4(10 / 3, -1 + 5, f3()) / 1)
print(-1)
print(f4(f3(), 0 * 1, -100) - ((7 * 1) % -2))
print(1)
